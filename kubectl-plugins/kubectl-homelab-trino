#!/bin/bash

# All arguments go straight to `trino`. Credentials come from a TRINO_CONFIG
# file written in the pod, since the CLI rejects repeated flags; any
# --server/--user the caller passes wins.
#
# Examples:
#   kubectl homelab trino --execute 'SHOW CATALOGS'
#   kubectl homelab trino --catalog hive --schema default
#
# Environment:
#   TRINO_NAMESPACE  Namespace holding Trino (default: trino)
#   TRINO_IMAGE      trino CLI image (default: the cluster's own coordinator image)
#   TRINO_URL        Server URL (default: https://trino.homelab.xiehang.com; must be
#                    HTTPS, the CLI refuses password auth over HTTP)

set -uo pipefail

# Follow the PATH symlink back to the repo so lib/ is found.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
    LINK="$(readlink "$SELF")"
    if [[ "$LINK" == /* ]]; then SELF="$LINK"; else SELF="$(dirname "$SELF")/$LINK"; fi
done
# shellcheck source=lib/oneshot.sh
. "$(cd "$(dirname "$SELF")" && pwd)/lib/oneshot.sh"

TRINO_NAMESPACE="${TRINO_NAMESPACE:-trino}"
TRINO_IMAGE="${TRINO_IMAGE:-}"
TRINO_URL="${TRINO_URL:-https://trino.homelab.xiehang.com}"

if ! kubectl get secret trino-credentials -n "$TRINO_NAMESPACE" >/dev/null 2>&1; then
    echo "Secret trino-credentials not found in namespace $TRINO_NAMESPACE" >&2
    exit 1
fi

if [[ -z "$TRINO_IMAGE" ]]; then
    TRINO_IMAGE=$(kubectl get deploy wl-trino-trino-coordinator -n "$TRINO_NAMESPACE" \
        -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null)
    [[ -z "$TRINO_IMAGE" ]] && TRINO_IMAGE="trinodb/trino:480"
fi

SCRIPT="export TRINO_CONFIG=\$(mktemp)
export TRINO_PASSWORD=\"\$(cat /etc/trino-admin/password)\"
cat > \"\$TRINO_CONFIG\" <<CFG
server=${TRINO_URL}
user=\$(cat /etc/trino-admin/username)
password=true
CFG
exec /usr/bin/trino \"\$@\""

CONTAINER='{ "volumeMounts": [{ "name": "admin-secret", "mountPath": "/etc/trino-admin", "readOnly": true }] }'
VOLUMES='[{ "name": "admin-secret", "secret": { "secretName": "trino-credentials" } }]'

oneshot_run "$TRINO_NAMESPACE" trino "$TRINO_IMAGE" "$SCRIPT" "$CONTAINER" "$VOLUMES" "$@"
exit $?
