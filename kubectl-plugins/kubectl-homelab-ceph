#!/bin/bash

# All arguments go straight to `ceph`, configured from rook-ceph-mon and rook-ceph-mon-endpoints.
#
# Examples:
#   kubectl homelab ceph -s
#   kubectl homelab ceph osd df
#   kubectl homelab ceph health detail
#
# Environment:
#   ROOK_NAMESPACE     Namespace holding the Ceph cluster (default: rook-ceph)
#   ROOK_CEPH_IMAGE    Ceph CLI image (default: the cluster's own ceph image)

set -uo pipefail

# Follow the PATH symlink back to the repo so lib/ is found.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
    LINK="$(readlink "$SELF")"
    if [[ "$LINK" == /* ]]; then SELF="$LINK"; else SELF="$(dirname "$SELF")/$LINK"; fi
done
# shellcheck source=lib/oneshot.sh
. "$(cd "$(dirname "$SELF")" && pwd)/lib/oneshot.sh"

ROOK_NAMESPACE="${ROOK_NAMESPACE:-rook-ceph}"
ROOK_CEPH_IMAGE="${ROOK_CEPH_IMAGE:-}"

if ! kubectl get secret rook-ceph-mon -n "$ROOK_NAMESPACE" >/dev/null 2>&1; then
    echo "Secret rook-ceph-mon not found in namespace $ROOK_NAMESPACE" >&2
    exit 1
fi

if [[ -z "$ROOK_CEPH_IMAGE" ]]; then
    ROOK_CEPH_IMAGE=$(kubectl get cephcluster -n "$ROOK_NAMESPACE" \
        -o jsonpath='{.items[0].spec.cephVersion.image}' 2>/dev/null)
    [[ -z "$ROOK_CEPH_IMAGE" ]] && ROOK_CEPH_IMAGE="quay.io/ceph/ceph:v19.2.4"
fi

# Same ceph.conf + keyring rook's toolbox writes.
# shellcheck disable=SC2016 # expands in the container, not here
SCRIPT='mkdir -p /etc/ceph
client_name=$(cat /etc/rook-ceph-mon/ceph-username)
mon_host=$(sed -E "s/[a-z0-9_-]+=//g" /etc/rook-ceph-mon-endpoints/data)
cat > /etc/ceph/ceph.conf <<CONF
[global]
mon_host = ${mon_host}

[${client_name}]
keyring = /etc/ceph/keyring
CONF
{
  echo "[${client_name}]"
  echo "    key = $(cat /etc/rook-ceph-mon/ceph-secret)"
} > /etc/ceph/keyring
exec ceph "$@"'

CONTAINER='{ "volumeMounts": [
    { "name": "mon-endpoints", "mountPath": "/etc/rook-ceph-mon-endpoints", "readOnly": true },
    { "name": "mon-secret", "mountPath": "/etc/rook-ceph-mon", "readOnly": true }
] }'
VOLUMES='[
    { "name": "mon-endpoints", "configMap": { "name": "rook-ceph-mon-endpoints", "items": [{ "key": "data", "path": "data" }] } },
    { "name": "mon-secret", "secret": { "secretName": "rook-ceph-mon" } }
]'

oneshot_run "$ROOK_NAMESPACE" ceph "$ROOK_CEPH_IMAGE" "$SCRIPT" "$CONTAINER" "$VOLUMES" "$@"
exit $?
