#!/bin/bash

# All arguments are passed straight to mysql. The connection defaults (host,
# root user and password) come from a ~/.my.cnf written in the pod, not
# prepended flags, so any -h/-u/-p the caller passes simply overrides them.
# Pick a database with -D or a positional name.
#
# Examples:
#   kubectl homelab mysql -e 'SHOW DATABASES'
#   kubectl homelab mysql some_database < dump.sql
#
# Environment:
#   MYSQL_NAMESPACE  Namespace holding MySQL (default: mysql)
#   MYSQL_IMAGE      mysql CLI image (default: the cluster's own server image)
#   MYSQL_HOST       Server host (default: mysql-cluster.<namespace>.svc.cluster.local)

set -uo pipefail

# Follow the PATH symlink back to the repo so lib/ is found.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
    LINK="$(readlink "$SELF")"
    if [[ "$LINK" == /* ]]; then SELF="$LINK"; else SELF="$(dirname "$SELF")/$LINK"; fi
done
# shellcheck source=lib/oneshot.sh
. "$(cd "$(dirname "$SELF")" && pwd)/lib/oneshot.sh"

MYSQL_NAMESPACE="${MYSQL_NAMESPACE:-mysql}"
MYSQL_IMAGE="${MYSQL_IMAGE:-}"
MYSQL_HOST="${MYSQL_HOST:-mysql-cluster.${MYSQL_NAMESPACE}.svc.cluster.local}"

if ! kubectl get secret mysql-root -n "$MYSQL_NAMESPACE" >/dev/null 2>&1; then
    echo "Secret mysql-root not found in namespace $MYSQL_NAMESPACE" >&2
    exit 1
fi

if [[ -z "$MYSQL_IMAGE" ]]; then
    MYSQL_IMAGE=$(kubectl get pods -n "$MYSQL_NAMESPACE" -l mysql.oracle.com/cluster=mysql-cluster \
        -o jsonpath='{.items[0].spec.containers[?(@.name=="mysql")].image}' 2>/dev/null)
    [[ -z "$MYSQL_IMAGE" ]] && MYSQL_IMAGE="container-registry.oracle.com/mysql/community-server:9.7.0"
fi

SCRIPT="export HOME=\$(mktemp -d)
cat > \"\$HOME/.my.cnf\" <<CNF
[client]
host=${MYSQL_HOST}
user=\$(cat /etc/mysql-admin/rootUser)
password=\"\$(cat /etc/mysql-admin/rootPassword)\"
CNF
chmod 600 \"\$HOME/.my.cnf\"
exec mysql \"\$@\""

CONTAINER='{ "volumeMounts": [{ "name": "admin-secret", "mountPath": "/etc/mysql-admin", "readOnly": true }] }'
VOLUMES='[{ "name": "admin-secret", "secret": { "secretName": "mysql-root" } }]'

oneshot_run "$MYSQL_NAMESPACE" mysql "$MYSQL_IMAGE" "$SCRIPT" "$CONTAINER" "$VOLUMES" "$@"
exit $?
