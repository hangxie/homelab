#!/bin/bash

# All arguments go straight to `clickhouse-client`. Credentials come from a
# config.xml written in the pod, since the CLI rejects repeated flags; any
# --host/--user/--password the caller passes wins.
#
# Examples:
#   kubectl homelab clickhouse --query 'SHOW DATABASES'
#   kubectl homelab clickhouse --database some_db
#
# Environment:
#   CLICKHOUSE_NAMESPACE  Namespace holding ClickHouse (default: clickhouse)
#   CLICKHOUSE_IMAGE      clickhouse-client image (default: the cluster's own server image)
#   CLICKHOUSE_HOST       Server host (default: clickhouse.<namespace>.svc.cluster.local)

set -uo pipefail

# Follow the PATH symlink back to the repo so lib/ is found.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
    LINK="$(readlink "$SELF")"
    if [[ "$LINK" == /* ]]; then SELF="$LINK"; else SELF="$(dirname "$SELF")/$LINK"; fi
done
# shellcheck source=lib/oneshot.sh
. "$(cd "$(dirname "$SELF")" && pwd)/lib/oneshot.sh"

CLICKHOUSE_NAMESPACE="${CLICKHOUSE_NAMESPACE:-clickhouse}"
CLICKHOUSE_IMAGE="${CLICKHOUSE_IMAGE:-}"
CLICKHOUSE_HOST="${CLICKHOUSE_HOST:-clickhouse.${CLICKHOUSE_NAMESPACE}.svc.cluster.local}"

if ! kubectl get secret clickhouse-credentials -n "$CLICKHOUSE_NAMESPACE" >/dev/null 2>&1; then
    echo "Secret clickhouse-credentials not found in namespace $CLICKHOUSE_NAMESPACE" >&2
    exit 1
fi

if [[ -z "$CLICKHOUSE_IMAGE" ]]; then
    CLICKHOUSE_IMAGE=$(kubectl get pods -n "$CLICKHOUSE_NAMESPACE" -l clickhouse.com/role=clickhouse-server \
        -o jsonpath='{.items[0].spec.containers[?(@.name=="clickhouse-server")].image}' 2>/dev/null)
    [[ -z "$CLICKHOUSE_IMAGE" ]] && CLICKHOUSE_IMAGE="clickhouse/clickhouse-server:25.7"
fi

# xml_escape keeps a credential with &, < or > from breaking the config.
SCRIPT="xml_escape() { sed -e 's/&/\\&amp;/g' -e 's/</\\&lt;/g' -e 's/>/\\&gt;/g' \"\$1\"; }
export HOME=\$(mktemp -d)
mkdir -p \"\$HOME/.clickhouse-client\"
cat > \"\$HOME/.clickhouse-client/config.xml\" <<XML
<config>
    <host>${CLICKHOUSE_HOST}</host>
    <user>\$(xml_escape /etc/clickhouse-admin/username)</user>
    <password>\$(xml_escape /etc/clickhouse-admin/password)</password>
</config>
XML
exec clickhouse-client \"\$@\""

CONTAINER='{ "volumeMounts": [{ "name": "admin-secret", "mountPath": "/etc/clickhouse-admin", "readOnly": true }] }'
VOLUMES='[{ "name": "admin-secret", "secret": { "secretName": "clickhouse-credentials" } }]'

oneshot_run "$CLICKHOUSE_NAMESPACE" clickhouse "$CLICKHOUSE_IMAGE" "$SCRIPT" "$CONTAINER" "$VOLUMES" "$@"
exit $?
