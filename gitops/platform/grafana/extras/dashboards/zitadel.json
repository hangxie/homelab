    {
      "type": "row",
      "title": "Database",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connection pool",
      "id": 16,
      "description": "Direct connections to postgres-cluster-rw (not through the pooler).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(zitadel_database_pool_acquired_conns{job=\"zitadel\"})",
          "legendFormat": "acquired",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "refId": "B",
          "expr": "max(zitadel_database_pool_idle_conns{job=\"zitadel\"})",
          "legendFormat": "idle",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "refId": "C",
          "expr": "max(zitadel_database_pool_total_conns{job=\"zitadel\"})",
          "legendFormat": "total",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "refId": "D",
          "expr": "max(zitadel_database_pool_max_conns{job=\"zitadel\"})",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pool acquire",
      "id": 17,
      "description": "Empty acquires had to wait for or open a connection; canceled ones gave up.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(zitadel_database_pool_acquire_duration_milliseconds_total{job=\"zitadel\"}[$__rate_interval])) / sum(rate(zitadel_database_pool_acquire_count_total{job=\"zitadel\"}[$__rate_interval]))",
          "legendFormat": "avg wait (ms)",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(zitadel_database_pool_empty_acquire_count_total{job=\"zitadel\"}[$__rate_interval]))",
          "legendFormat": "empty acquires/s",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(zitadel_database_pool_canceled_acquire_count_total{job=\"zitadel\"}[$__rate_interval]))",
          "legendFormat": "canceled/s",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Projections",
      "id": 18,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Projection lag p95 (top 10)",
      "id": 19,
      "description": "Time from an event being written to its projection catching up. Reads come from projections.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, projection) (rate(projection_state_latency_seconds_bucket{job=\"zitadel\"}[$__rate_interval]))))",
          "legendFormat": "{{projection}}",
