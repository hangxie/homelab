        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum (increase(istio_tcp_connections_failed_total{reporter=\"destination\",destination_workload_namespace=~\"$namespace\",connection_security_policy!=\"mutual_tls\",response_flags=\"DENY\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "refId": "R",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$C - $D"
        }
      ],
