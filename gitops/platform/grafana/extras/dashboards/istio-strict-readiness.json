    {
      "type": "stat",
      "title": "Plaintext connections STRICT would reject",
      "description": "Plaintext opened minus plaintext denied: inbound connections to enrolled workloads that arrived without mTLS and were accepted (PERMISSIVE). Under STRICT each of these callers is rejected unless its port has a PERMISSIVE exception.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum (increase(istio_tcp_connections_opened_total{reporter=\"destination\",destination_workload_namespace=~\"$namespace\",connection_security_policy!=\"mutual_tls\"}[$__range])) or vector(0)",
